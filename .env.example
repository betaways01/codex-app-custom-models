# Copy to ~/.opencodex/ or export in your shell. Never commit real values.
# Setup script writes keys into ~/.opencodex/config.json (mode 600).

# MiMo Token Plan — https://xiaomimimo.com  (Plan usage → Dedicated API Key)
MIMO_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# GLM Coding Plan — https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# Grok / xAI uses OAuth. No key file:
#   opencodex login xai
