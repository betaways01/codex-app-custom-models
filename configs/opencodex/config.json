        "deepseek-v4-pro": [
          "low",
          "high",
          "max"
        ]
      },
      "modelReasoningEffortMap": {
        "deepseek-flash": {
          "minimal": "low",
          "low": "low",
          "medium": "high",
          "high": "high",
          "xhigh": "high",
          "max": "max"
