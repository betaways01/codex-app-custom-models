{
  "port": 10100,
  "defaultProvider": "openai",
  "emptyCompletionRetry": true,
  "codexAutoStart": true,
  "websockets": false,
  "providers": {
    "openai": {
      "adapter": "openai-responses",
      "baseUrl": "https://chatgpt.com/backend-api/codex",
      "codexAccountMode": "direct",
      "authMode": "forward"
    },
    "xai": {
      "adapter": "openai-chat",
      "baseUrl": "https://api.x.ai/v1",
      "authMode": "oauth",
      "defaultModel": "grok-4.6",
      "models": [
        "grok-4.6",
        "grok-4.5"
      ],
      "liveModels": true,
      "modelContextWindows": {
        "grok-4.6": 500000,
        "grok-4.5": 500000
      },
      "modelInputModalities": {
        "grok-4.6": [
          "text",
          "image"
        ],
        "grok-4.5": [
          "text",
          "image"
        ]
      },
      "modelReasoningEfforts": {
        "grok-4.6": [
          "low",
          "medium",
          "high",
          "xhigh"
        ],
        "grok-4.5": [
          "low",
          "medium",
          "high"
        ]
      },
      "modelDefaultReasoningEfforts": {
        "grok-4.6": "high"
      },
      "modelReasoningEffortMap": {
        "grok-4.6": {
          "low": "low",
          "medium": "medium",
          "high": "high",
          "xhigh": "xhigh",
          "max": "xhigh",
          "ultra": "xhigh"
        },
        "grok-4.5": {
          "low": "low",
          "medium": "medium",
          "high": "high",
          "xhigh": "high",
          "max": "high",
          "ultra": "high"
        }
      },
      "preserveReasoningContentModels": [
        "grok-4.6",
        "grok-4.5"
      ],
      "selectedModels": [
        "grok-4.6"
      ]
    },
    "deepseek": {
      "adapter": "openai-chat",
      "baseUrl": "https://api.deepseek.com",
